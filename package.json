{
  "name": "nocturnal-synthesis-midi-studio",
  "version": "1.1.0",
  "private": true,
  "description": "50 validated synthwave and darkwave lead MIDI loops, with a browser lab that plays the real files.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 43123",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 43123",
    "pack": "python3 scripts/build_pack.py",
    "validate": "python3 scripts/validate.py && node scripts/validate-tonejs.mjs",
    "validate:midi": "python3 scripts/build_pack.py && python3 scripts/validate.py && node scripts/validate-tonejs.mjs && python3 scripts/build_standalone_dashboard.py",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tonejs/midi": "^2.0.28",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "marked": "^18.1.1",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  },
  "license": "MIT"
}
